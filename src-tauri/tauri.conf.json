{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Json Studio",
  "version": "1.4.0",
  "identifier": "com.jsonstudio.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Json Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "transparent": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 20
        },
        "zoomHotkeysEnabled": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",      
      "dmg",       
      "appimage"   
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Fast, modern, and efficient JSON desktop tool",
    "longDescription": "A modern JSON desktop application built with Tauri 2.0 and Rust, providing common features like formatting, compression, escaping, and comparison",
    "copyright": "Copyright © 2025 Json Studio",
    "category": "DeveloperTool",
    "fileAssociations": [
      {
        "ext": ["json"],
        "name": "JSON Document",
        "role": "Editor",
        "rank": "Owner",
        "contentTypes": [
          "public.json"
        ]
      },
      {
        "ext": [
          "json5",
          "jsonc",
          "geojson",
          "topojson",
          "har",
          "webmanifest",
          "ipynb",
          "sarif"
        ],
        "name": "JSON Document",
        "role": "Editor",
        "rank": "Owner",
        "contentTypes": [
          "com.jsonstudio.json-document"
        ],
        "exportedType": {
          "identifier": "com.jsonstudio.json-document",
          "conformsTo": ["public.json"]
        }
      },
      {
        "ext": ["jsonl", "ndjson"],
        "name": "JSON Lines Document",
        "description": "Newline-delimited JSON records",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-ndjson",
        "contentTypes": [
          "com.jsonstudio.json-lines"
        ],
        "exportedType": {
          "identifier": "com.jsonstudio.json-lines",
          "conformsTo": ["public.text"]
        }
      }
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4NjBCRUM4RTY4ODAwQUIKUldTckFJam15TDVnS0x2cnZScEFna0kwUytmTmlVdFFoY3JlaEx5Umo4UkZJcFdEQ05LVWZDOEIK",
      "endpoints": [
        "https://github.com/sundegan/JsonStudio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
